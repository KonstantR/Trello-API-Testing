            "type": "text/javascript",
            "exec": [
              "const responseBody = pm.response.json();",
              "",
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Board name matches the generated name\", function () {",
              "    pm.expect(responseBody.name).to.eql(pm.collectionVariables.get(\"boardName\"));",
              "});",
              "",
              "pm.test(\"Response has a valid board ID\", function () {",
              "    pm.expect(responseBody.id).to.be.a(\"string\").and.not.empty;",
              "});",
              "",
              "if (responseBody.id) {",
              "    pm.collectionVariables.set(\"boardId\", responseBody.id);",
              "}"
            ]
          }
        },
