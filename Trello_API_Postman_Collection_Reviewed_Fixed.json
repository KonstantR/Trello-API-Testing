    {
      "name": "Create List With Random Name in Board",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {\n    pm.response.to.have.status(200);\n});\n\nconst responseBody = pm.response.json();\npm.collectionVariables.set(\"listId\", responseBody.id);\n\npm.test(\"Response contains the expected properties\", function () {\n    pm.expect(responseBody).to.include.all.keys('id', 'name', 'closed', 'color', 'idBoard', 'pos', 'limits', 'subscribed', 'softLimit', 'type', 'datasource');\n});\n\npm.test(\"Closed property is false\", function () {\n    pm.expect(responseBody.closed).to.be.a('boolean').and.to.be.false;\n});\n\npm.test(\"idBoard matches expected board ID\", function () {\n    pm.expect(responseBody.idBoard).to.equal(pm.collectionVariables.get(\"boardId\"));\n});\n\npm.test(\"Name matches expected list name\", function () {\n    pm.expect(responseBody.name).to.equal(pm.collectionVariables.get(\"listName\"));\n});"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var uniqueName = \"List\" + Math.floor(Math.random() * 100000);\r\npm.collectionVariables.set(\"listName\", uniqueName);\r\n"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/1/lists?name={{listName}}&idBoard={{boardId}}&key={{trelloKey}}&token={{trelloToken}}",
          "host": [
