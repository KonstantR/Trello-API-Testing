          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Response time is less than 30sec\", function () {\r\n    pm.expect(pm.response.responseTime, \"Response time\").to.be.below(30000);\r\n});\r\n\r\npm.test(\"Response body is not empty\", function () {\r\n    pm.expect(pm.response.text(), \"Response body\").to.not.be.empty;\r\n})"
            ]
          }
        }
      ],
